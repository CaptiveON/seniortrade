# Copy to .env and fill in. .env is gitignored — NEVER commit real keys.
#
# FULL .env CONTROL: every field of every config section is overridable with a
# {SECTION}_{FIELD} env var (type-coerced). Only the most useful knobs are listed
# below with their DEFAULTS — see src/config.py for the complete field list per
# section. The active config is printed back by the CLI so nothing is opaque.
# Sections + prefixes: SCREEN_ STRUCT_ ANALYSIS_ SETUP_ MARKETS_ RISK_ MGMT_
# BACKTEST_ EDGE_ GUARDS_ JOURNAL_ ALERTS_ WATCH_ ORDER_ OPTIMIZE_ LIVE_.
#
# IMPORTANT: screen/analyze/backtest use PUBLIC data and need NO API key. A key is
# only needed for the order layer. When you create one on Binance:
#   * Enable Reading + Spot/Futures Trading ONLY. Do NOT enable Withdrawals.
#   * Restrict to your IP. Use a dedicated sub-account / key.

BINANCE_API_KEY=
BINANCE_API_SECRET=

# --- REAL-MONEY ARM FLAG (--live; safety rail, NOT tunable from here) ----------
#   `--live` is OFF until this equals the EXACT value. Prefer `export`-ing it for a
#   single shell session rather than leaving it here. TEST ON --testnet FIRST.
# LIVE_TRADING_ENABLED=I_UNDERSTAND_THE_RISK

# ============================ ACCOUNT & RISK ==================================
# ACCOUNT_EQUITY=1000          # your account equity (used for sizing in $)
# RISK_PCT=1.0                 # BASE % of equity risked per trade (size is derived from the stop)

# --- EFFECTIVE-RISK PIPELINE (MGMT_*) : base% → ×drawdown → ×edge → Kelly → ceiling
#   Every stage is OPT-IN (off by default → flat base %). Each fired stage is shown.
# MGMT_MAX_RISK_PCT=5.0        # HARD ceiling the pipeline can never exceed (a backstop)
# MGMT_DD_SCALE_ENABLED=false  # reduce risk as the account draws down
# MGMT_DD_SCALE_START=5.0      #   start scaling past this % drawdown
# MGMT_DD_SCALE_FULL=20.0      #   drawdown % at which the floor multiplier is reached
# MGMT_DD_SCALE_FLOOR=0.5      #   risk multiplier never drops below this
# MGMT_EDGE_SCALED=false       # size from the EDGE×confidence (more on proven, less on marginal)
# MGMT_EDGE_REF_R=0.15         #   edge (R) that maps to ×1.0
# MGMT_EDGE_MIN_MULT=0.5       #   clamp the edge multiplier to [min, max]
# MGMT_EDGE_MAX_MULT=2.0
# MGMT_VOL_TARGET_ENABLED=false # size from VARIANCE: equalise per-trade dollar-volatility (P12)
# MGMT_VOL_TARGET_SIGMA_R=1.5  #   the σ_R that maps to ×1.0; wilder setups are sized smaller
# MGMT_VOL_MIN_MULT=0.5        #   clamp the vol multiplier to [min, max]
# MGMT_VOL_MAX_MULT=1.0        #   1.0 = only ever REDUCES (conservative); raise to allow scaling up
# MGMT_KELLY_ENABLED=false     # fractional-Kelly cap (only ever REDUCES risk)
# MGMT_KELLY_FRACTION=0.25
# MGMT_TP1_FRACTION=0.5        # scale-out fraction at TP1
# MGMT_MIN_NET_RR=1.2          # net R:R below this → NO TRADE

# ============================ PORTFOLIO GUARDS (GUARDS_*) =====================
# GUARDS_HEAT_CAP_PCT=6.0           # max TOTAL open risk as % equity (group-aware)
# GUARDS_DAILY_LOSS_LIMIT_R=3.0     # realised ≤ −this R today → hard lockout
# GUARDS_MAX_TRADES_PER_DAY=0       # ≤ N new trades/day (0 = unlimited; over-trading guard)
# GUARDS_MAX_POSITIONS=5            # max concurrent open positions
# GUARDS_MAX_PER_GROUP=2            # max per influence group (soft)
# GUARDS_COOLDOWN_MINUTES=60        # block new entries this long after a loss
# GUARDS_COOLDOWN_CONSECUTIVE_LOSSES=3   # this many losses in a row → session lock

# ============================ EDGE / BOARD (EDGE_*) ===========================
# EDGE_FLOOR=0.05              # min trustworthy edge (R) to count as an edge
# EDGE_MIN_REGIME_N=20         # min trades in the current regime to trust it
# EDGE_SIG_Z=1.65              # significance bound on the null-excess gate (~95% one-sided)
# EDGE_SCAN_TOP=                # deep-scan only top-N survivors (blank = ALL that pass the screen)
# EDGE_POOL_COINS=12           # coins pooled for the universe edge verdict
# EDGE_CACHE_TTL_HOURS=24      # re-backtest if the cached profile is older

# ============================ BACKTEST / NULL (BACKTEST_*) ====================
# BACKTEST_CANDLE_LIMIT=1000   # history fetched per coin (ANY size — auto-paginates past the
#                                exchange's ~1000/req cap; 2000×4h ≈ 333d. Deeper = more trades but
#                                older regimes — pair with BACKTEST_TIME_DECAY_ENABLED. Rebuild: scan --refresh)
# BACKTEST_MIN_SAMPLE=30       # trades required before a verdict
# BACKTEST_NULL_K=10           # matched-geometry shadow trades per real trade (0 = disable null)
# BACKTEST_SIG_Z=1.65          # significance bound for the +EV verdict's null test
# BACKTEST_TIME_DECAY_ENABLED=false      # P7: weight recent trades more (markets evolve); off = unweighted
# BACKTEST_TIME_DECAY_HALF_LIFE_DAYS=90  #   a trade this many days old counts half (gradual decay)
# BACKTEST_DEFF_ENABLED=true             # cross-coin correlation: widen SEs by the MEASURED design effect
# BACKTEST_DEFF_BUCKET_HOURS=24          #   correlation cluster = same UTC day (honesty — leave on)

# ============================ SCREENER (SCREEN_*) ============================
# SCREEN_TOP_N=100             # universe width (top-N by 24h volume)
# SCREEN_MIN_QUOTE_VOLUME=5000000
# SCREEN_MAX_SPREAD_BPS=8
# SCREEN_MIN_CANDLES=200
# SCREEN_TF=1d                 # screen timeframe
# SCREEN_FETCH_WORKERS=4       # concurrent OHLCV fetch workers

# ============================ WATCH RADAR (WATCH_*) ==========================
# WATCH_POLL_SECONDS=60        # light between-bar price/alert cadence
# WATCH_DIGEST_SECONDS=3600    # hourly status digest
# WATCH_COOLDOWN_MINUTES=60    # don't re-ping the same coin within this window
# WATCH_NOTIFY=true            # macOS desktop notifications
